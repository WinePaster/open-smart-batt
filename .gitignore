# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Flutter / Android (future app)
**/.dart_tool/
**/build/
*.apk
*.aab
.gradle/
local.properties
key.properties
*.keystore
