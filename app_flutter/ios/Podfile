# Deployment target floor: 15.0.
#
# Two constraints, and APPLE's is now the binding one:
#
#   * >= the highest pod podspec minimum (flutter_blue_plus_darwin 7.x was the
#     effective floor, and set 13.0 here until 2026-08-06);
#   * >= 15.0, because App Store Connect warns on upload that from Spring 2027
#     it will REFUSE any build with a MinimumOSVersion below 15.0. Seen on the
#     v0.7.5 archive.
#
# Raising 13.0 → 15.0 costs no hardware: iOS 15 runs on exactly the same devices
# as iOS 13 (iPhone 6s / iPad Air 2 and later). iOS 16 is where that generation
# was dropped — so do NOT raise this to 16+ casually, that one is not free.
#
# ⚠️ Keep this in step with IPHONEOS_DEPLOYMENT_TARGET in project.pbxproj (three
# configs) and with the post_install override below. Three places, one number.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # C.1 — pin deployment target floor for every pod target/config.
      # ⚠️ Must equal `platform :ios` at the top of this file; a pod left below
      # the app's own floor is what produces the "MinimumOSVersion too low"
      # upload warning even after project.pbxproj has been raised.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # C.2 — permission_handler macros. Disable every permission so unused
      # handlers are compiled out (avoids ITMS-90683 auto-rejection). Must be a
      # Ruby array with '$(inherited)' first (never string-concatenated) so the
      # COCOAPODS=1 / DEBUG=1 / Flutter inherited macros are preserved.
      #
      # 🔴 A permission the app ACTUALLY REQUESTS must be `=1` here, or it is
      # not merely unavailable — it lies. With the macro at 0 the plugin swaps
      # in `UnknownPermissionStrategy`, whose `requestPermission:` returns
      # `PermissionStatusPermanentlyDenied` WITHOUT EVER CONSTRUCTING a
      # CLLocationManager (permission_handler_apple 9.5.0,
      # `PermissionManager.m:103-107` + `UnknownPermissionStrategy.m:19-21`).
      # So: no system dialog, iOS never records a request, and the app's own
      # page in 設定 has no 定位 row at all — the "open Settings" escape hatch
      # leads somewhere with nothing to fix. Reported from the field on
      # v0.7.7 (2026-08-07) as「沒有權限」.
      #
      # `ios_permission_macros_test.dart` derives the required set from
      # `lib/` and fails if this list and the code disagree.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_CAMERA=0',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_PHOTOS=0',
        # WhenInUse ON, plain LOCATION off: the latter also compiles in
        # `requestAlwaysAuthorization`, which needs
        # NSLocationAlwaysAndWhenInUseUsageDescription — a key this app
        # deliberately does not have (design 0042 N1, foreground only).
        'PERMISSION_LOCATION=0',
        'PERMISSION_LOCATION_WHENINUSE=1',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
