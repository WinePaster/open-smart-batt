<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenSmartBatt</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleName</key>
	<string>open_smart_batt</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>本 App 需要使用藍牙以連線並控制您的 智慧電池或電容模組（BLE）。</string>
	<!-- design 0042 §3.5. The parenthesis is not marketing copy — it is G5's
	     promise to the user, and the wording was corrected once already: an
	     earlier draft said "速度資訊不會被儲存或上傳", which the same design
	     contradicts (speed DOES go to history and to exports; only the
	     coordinate is forbidden). Keep the promise and the implementation
	     saying the same thing.
	     WhenInUse only. No NSLocationAlways* key: the GPS speed feature is
	     foreground-only (0042 N1). The UIBackgroundModes entry below belongs
	     to BLE (design 0047), NOT to location. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>顯示騎乘速度時需要取得定位（位置座標不會被儲存或上傳）。</string>
	<!-- design 0047 Phase 1. bluetooth-central lets GATT events (notify /
	     disconnect) on an already-connected peripheral wake the app for a short
	     execution window while it is backgrounded, so the frame-driven history
	     pipeline keeps writing its per-minute rows for as long as the link can
	     be maintained. This is NOT a promise of an always-alive background link: iOS
	     scheduling and Low Power Mode still decide when the app runs, minutes
	     where the link is down are honestly absent from history, and the
	     event-driven keep-alive that makes the device keep streaming is gated
	     behind the (default-off) background-monitoring setting. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<!-- iPad multitasking (iOS 26 SDK) requires all 4 orientations declared;
		     UIRequiresFullScreen is deprecated. The app still locks to portrait at
		     runtime via SystemChrome.setPreferredOrientations in main.dart. -->
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
