  "gForceCardHeading": "G meter",
  "@gForceCardHeading": {
    "description": "Heading of the G meter card and its name in the module vocabulary (design 0045 §3.6). \"G\" is the racing convention for multiples of gravity and is left untranslated in both locales for that reason."
  },
  "gForceLongLabel": "Long",
