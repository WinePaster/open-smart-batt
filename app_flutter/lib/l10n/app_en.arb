  },
  "gWizardTitle": "Calibrate G meter",
  "@gWizardTitle": {
    "description": "Title of the calibration wizard route."
  },
  "gWizardMountTitle": "Mount the phone first",
  "@gWizardMountTitle": {
    "description": "Step 0 heading."
  },
  "gWizardMountBody": "Fix the phone to the frame the way you ride with it. The calibration describes THAT position - moving the phone afterwards means doing this again.",
  "@gWizardMountBody": {
    "description": "Step 0 body."
  },
  "gWizardStart": "Start",
  "@gWizardStart": {
    "description": "Button that begins the still measurement."
  },
  "gWizardStillTitle": "Hold still",
  "@gWizardStillTitle": {
    "description": "Step 1 heading."
  },
  "gWizardStillBody": "Stand the bike upright — centre stand or level ground, not the side stand — then keep still. Measuring which way is up.",
  "@gWizardStillBody": {
    "description": "Step 1 body."
  },
  "gWizardMovedTitle": "It moved",
  "@gWizardMovedTitle": {
    "description": "Shown when the still window was broken."
  },
  "gWizardMovedBody": "Something moved while measuring, so the reading would not have been gravity alone. Try again.",
  "@gWizardMovedBody": {
    "description": "Body of the failed-motion state."
  },
  "gWizardRetry": "Try again",
  "@gWizardRetry": {
    "description": "Restarts the wizard from the still step."
  },
  "gWizardLaunchTitle": "Now pull away in a straight line",
  "@gWizardLaunchTitle": {
    "description": "Step 2 heading."
  },
  "gWizardLaunchBody": "Ride off gently and straight ahead for a couple of seconds. That is how the app learns which way is forward - a launch taken while turning will point it the wrong way.",
  "@gWizardLaunchBody": {
    "description": "Step 2 body. It says why, because the accuracy of the whole feature depends on the user understanding this one instruction."
  },
  "gWizardDoneTitle": "Calibrated",
  "@gWizardDoneTitle": {
    "description": "Step 3 heading."
  },
  "gWizardDoneBody": "Check it: accelerating should push the dot straight up, braking straight down. If it leans, calibrate again.",
  "@gWizardDoneBody": {
    "description": "Step 3 body - the visual check that backs up the straight-launch assumption (design 0045 section 3.2)."
  },
