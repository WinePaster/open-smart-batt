  },
  "gForceResetPeakHint": "Tap the peak to reset",
  "@gForceResetPeakHint": {
    "description": "One-line hint under the readouts. The peak readout is a tap target and nothing about a number looks tappable."
  },
  "settingsGMeterLabel": "G meter",
  "@settingsGMeterLabel": {
    "description": "Label of the G meter master switch (design 0045 Q2). Independent of speed detection: it uses the accelerometer, not GPS."
  },
  "settingsGMeterSub": "Add a longitudinal / lateral G card to the home page. Needs a one-off calibration. Off by default.",
  "@settingsGMeterSub": {
    "description": "Sub-line of the G meter switch. It names the calibration because a user who turns this on and sees nothing has hit exactly that. 🔴 REWRITTEN 2026-08-09 (design 0051): it used to name the 'Riding' watchface, which no longer carries this card — or exists as a choice. Same reasoning as settingsSpeedDetectionSub."
  },
  "settingsGCalibrationLabel": "Calibrate mount",
  "@settingsGCalibrationLabel": {
    "description": "Label of the calibration row, under the switch. It both starts a first calibration and redoes an existing one (design 0045 section 3.5 - the wizard lives in Settings, never on the dashboard)."
  },
  "settingsGCalibrationNever": "Not calibrated yet - the card will not appear",
  "@settingsGCalibrationNever": {
    "description": "Sub-line when there is no stored calibration. It states the CONSEQUENCE rather than only the state, because design 0045 Q8 removed the dashboard placeholder that used to explain it and R1 warns this is now the likeliest long-term state."
  },
  "settingsGCalibrationInvalid": "Calibration is no longer valid - the mount seems to have moved",
